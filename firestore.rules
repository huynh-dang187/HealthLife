rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // daily_tips: mọi người đọc được (tip sức khỏe), ghi qua backend
    match /daily_tips/{id} {
      allow read: if true;
      allow write: if false;
    }

    // foods: kho dữ liệu thực phẩm, user đã đăng nhập đọc được để tìm kiếm;
    // ghi chỉ qua script import (REST admin)
    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // sos_devices: một thiết bị cho phép tối đa 3 user ghép nối (recipientIds).
    // - Đọc: user đã đăng nhập (cần đọc để kiểm tra mã khi ghép).
    // - Tạo: chỉ user đầu tiên tạo, với danh sách người nhận chứa đúng mình.
    // - Cập nhật: thêm mình khi chưa đủ 3 (nối), hoặc gỡ một thành viên bất kỳ
    //   (rời nhóm tự do / xoá thành viên khác) — chỉ người đang kết nối được sửa.
    match /sos_devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.recipientIds is list
          && request.resource.data.recipientIds.hasOnly([request.auth.uid]);
      allow update: if request.auth != null
          && resource.data.recipientIds is list
          && (
            // A) Thêm đúng 1 người:
            //    - người trong nhóm mời thêm 1 người bất kỳ (chưa đủ 3), hoặc
            //    - tự join: mình chưa có, sau update chỉ thêm đúng mình
            (request.resource.data.recipientIds.size()
                    == resource.data.recipientIds.size() + 1
                && request.resource.data.recipientIds
                    .diff(resource.data.recipientIds)
                    .affectedKeys()
                    .size() == 1
                && resource.data.recipientIds.size() < 3
                && (
                  resource.data.recipientIds.hasAny([request.auth.uid])
                  || (!resource.data.recipientIds.hasAny([request.auth.uid])
                      && request.resource.data.recipientIds
                          .diff(resource.data.recipientIds)
                          .affectedKeys()
                          .hasOnly([request.auth.uid]))
                ))
            // B) Gỡ đúng 1 người (xoá thành viên / tự rời nhóm):
            //    mình là người trong nhóm
            || (request.resource.data.recipientIds.size()
                    == resource.data.recipientIds.size() - 1
                && resource.data.recipientIds.hasAny([request.auth.uid])
                && resource.data.recipientIds
                    .diff(request.resource.data.recipientIds)
                    .affectedKeys()
                    .size() == 1)
          );
    }

    // sos_alerts: chỉ người ghép nối với device đó (nằm trong recipientIds)
    // đọc được lịch sử cảnh báo.
    function isDeviceRecipient(deviceId) {
      let device = get(/databases/$(database)/documents/sos_devices/$(deviceId));
      return device != null && device.exists
          && device.data.recipientIds is list
          && device.data.recipientIds.hasAny([request.auth.uid]);
    }
    match /sos_alerts/{alertId} {
      allow read: if request.auth != null
          && isDeviceRecipient(resource.data.deviceId);
    }

    // users: mọi user đã đăng nhập đọc được (tìm người nhận theo SĐT,
    // hiện tên), mỗi user chỉ ghi profile của chính mình
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // meal_logs: nhật ký ăn, chỉ chủ sở hữu đọc/ghi
      match /meal_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // daily_steps: lịch sử bước chân, chỉ chủ sở hữu đọc/ghi
      match /daily_steps/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // chat_sessions: phiên trò chuyện BiBi, chỉ chủ sở hữu đọc/ghi
      match /chat_sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // messages: tin nhắn trong phiên, chỉ chủ sở hữu đọc/ghi
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // các collection khác: mặc định chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}